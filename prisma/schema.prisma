generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Auth ---

enum Role {
  RATE_MANAGER
  STAFF
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          Role      @default(STAFF)
  createdAt     DateTime  @default(now())

  accounts          Account[]
  sessions          Session[]
  sourceDocuments   SourceDocument[]
  extractionReviews ExtractionRun[]   @relation("ReviewedBy")
  publishedCards    RateCard[]        @relation("PublishedBy")
  quotes            Quote[]
  conversations     Conversation[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- Rate data ---

model Property {
  id          String @id @default(cuid())
  slug        String @unique
  displayName String
  region      String
  category    String // soroi-lodge | non-soroi-lodge | nairobi-hotel | transport | flight

  rateCards RateCard[]

  @@index([category])
}

model SourceDocument {
  id           String   @id @default(cuid())
  filename     String
  storageKey   String // Descriptive label only, e.g. "not-persisted:<original filename>" - the raw
  // uploaded file itself is processed in-memory and never saved (same no-server-storage
  // model as quote PDFs). The durable record of what was in it is the ExtractionRun /
  // RateCard / RateFigure rows it produced, not this field.
  uploadedById String
  uploadedAt   DateTime @default(now())

  uploadedBy    User            @relation(fields: [uploadedById], references: [id])
  rateCards     RateCard[]
  extractionRuns ExtractionRun[]
}

model ExtractionRun {
  id               String   @id @default(cuid())
  sourceDocumentId String
  status           String   @default("pending_review") // pending_review | approved | rejected
  proposedFigures  Json
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime @default(now())

  sourceDocument SourceDocument @relation(fields: [sourceDocumentId], references: [id])
  reviewedBy     User?          @relation("ReviewedBy", fields: [reviewedById], references: [id])
}

model RateCard {
  id                String    @id @default(cuid())
  propertyId        String
  tier              String // "Rack Rate" | "STO 30%" | "Contract - Silver" ...
  residency         String // "Non-Resident" | "Resident"
  validityStart     DateTime
  validityEnd       DateTime
  standInForYear    Int?
  standInReason     String?
  standInConfirmed  Boolean   @default(false)
  mandatoryFeeShape String? // this property's own fee shape - never assumed shared
  sourceDocumentId  String
  status            String    @default("draft") // draft | published | superseded
  supersedesId      String?   @unique
  supersedeReason   String?
  publishedById     String?
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())

  property       Property        @relation(fields: [propertyId], references: [id])
  sourceDocument SourceDocument  @relation(fields: [sourceDocumentId], references: [id])
  publishedBy    User?           @relation("PublishedBy", fields: [publishedById], references: [id])
  supersedes     RateCard?       @relation("Supersession", fields: [supersedesId], references: [id])
  supersededBy   RateCard?       @relation("Supersession")
  figures        RateFigure[]
  seasons        RateCardSeason[]
  events         RateCardEvent[]

  @@index([propertyId, tier, residency, validityStart, validityEnd])
}

// A named season (e.g. "peak") can cover multiple disjoint calendar ranges
// (e.g. Peak = 1 Jul-30 Sep AND 20 Dec-2 Jan) - one row per range.
model RateCardSeason {
  id             String   @id @default(cuid())
  rateCardId     String
  seasonName     String // "peak" | "shoulder" | "extendedGreen" | "green" | ...
  dateRangeStart DateTime
  dateRangeEnd   DateTime
  rawLabel       String? // original source string, e.g. "1 Jul - 31 Oct", for traceability

  rateCard RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)

  @@index([rateCardId, seasonName])
}

model RateFigure {
  id             String    @id @default(cuid())
  rateCardId     String
  category       String // accommodation | mandatory_fee | portfolio_term
  path           String // e.g. "luxuryTents.fullBoard.single"
  season         String?
  dateRangeStart DateTime?
  dateRangeEnd   DateTime?
  occupancy      String? // adult | child | single | familyUnit | null
  amount         Decimal
  unit           String // "per person per night" | "per adult per 12h" | "per vehicle per day" | "%"
  currency       String    @default("USD")
  verified       Boolean   @default(false) // required - never a free-text substitute
  confidenceNote String?
  sourcePage     Int?

  rateCard RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)

  @@index([rateCardId, category])
}

// Append-only audit trail - mirrors the project's Corrections Log philosophy
model RateCardEvent {
  id         String   @id @default(cuid())
  rateCardId String
  eventType  String // created | published | superseded
  note       String?
  createdAt  DateTime @default(now())

  rateCard RateCard @relation(fields: [rateCardId], references: [id])
}

// --- Quote registry ---

model QuoteSequence {
  preparerInitials String
  date             DateTime @db.Date
  nextSeq          Int      @default(1)

  @@id([preparerInitials, date])
}

model Quote {
  id              String    @id @default(cuid())
  quoteId         String    @unique // "SQ-YM-20260805-002"
  preparerId      String
  dateIssued      DateTime  @default(now())
  route           String
  status          String    @default("draft") // draft only for now - no separate approval role yet
  // The structured QuoteDocumentData used to generate the PDFs - NOT the PDF itself.
  // PDFs are rendered on demand and streamed straight to the browser, never stored
  // server-side (see lib/render/render-pdf.ts); this is what makes a later "regenerate
  // the PDF" possible even though no file was ever kept.
  documentData    Json?
  supersedesId    String?   @unique
  supersedeReason String?
  createdAt       DateTime  @default(now())

  preparer     User          @relation(fields: [preparerId], references: [id])
  supersedes   Quote?        @relation("QuoteSupersession", fields: [supersedesId], references: [id])
  supersededBy Quote?        @relation("QuoteSupersession")
  conversation Conversation?
}

// --- Conversational quoting agent ---

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  quoteId   String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                 @relation(fields: [userId], references: [id])
  quote    Quote?               @relation(fields: [quoteId], references: [id])
  messages ConversationMessage[]
}

model ConversationMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user | assistant | tool
  content        Json
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
