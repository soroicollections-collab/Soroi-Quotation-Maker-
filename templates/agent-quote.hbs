<title>Soroi Safari Quotation — Agent Copy</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Poppins:wght@400;500;600&family=Alex+Brush&display=swap');
  :root {
    --gold: #C4A265;
    --gold-deep: #B8843F;
    --band: #A97A45;
    --earth: #3D2B1F;
    --earth-deep: #2A1D14;
    --bg: #FBF7F0;
    --tan: #EADFC8;
    --tan-light: #F4EEE1;
    --grey: #7A6A55;
    --line: #E4D6BE;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; background: var(--bg); }
  body { font-family: 'Poppins', sans-serif; color: var(--earth); }
  @page { size: A4; margin: 0; }
  /* Named page for the flowing financial-detail section below: real margins that repeat
     on every physical page it spans, unlike padding/margin on the flowing box itself
     (which only applies once, at the very start/end of the whole box - see the .detail-wrap
     rule). The fixed cover/itinerary boxes above stay on the default (margin: 0) page so
     they can keep their full-bleed design. */
  @page detail { size: A4; margin: 16mm; }

  /* ============ PAGES 1-2: fixed A4 boxes, byte-identical to the client
     template's cover + itinerary design. The agent copy is the client copy
     PLUS more information, not a different-looking document - only the
     financial detail pages (below) differ in structure, since that content's
     length varies with itinerary complexity and can't be boxed like a cover. ============ */
  .page {
    width: 210mm; height: 297mm;
    position: relative;
    overflow: hidden;
    background: var(--bg);
    page-break-after: always;
    margin: 0 auto;
  }
  .page.cover { display: flex; flex-direction: column; }

  .draft-tag {
    position: absolute; top: 0; left: 0; right: 0;
    text-align: center; background: #fdf0ef; border-bottom: 1.5px solid #c0392b;
    color: #c0392b; font-weight: 600; font-size: 8px; letter-spacing: 0.06em;
    padding: 3px 0; z-index: 50; font-family: 'Poppins', sans-serif;
  }

  .doc-topbar { display: flex; align-items: center; justify-content: space-between; padding: 13mm 16mm 0; }
  .doc-topbar .side { font-size: 9px; letter-spacing: 0.15em; color: var(--gold-deep); font-weight: 600; text-transform: uppercase; white-space: nowrap; }
  .doc-topbar .mark { display: flex; align-items: center; gap: 10px; }
  .doc-topbar .rule { flex: 1; height: 1px; background: var(--gold); opacity: 0.55; min-width: 40px; }
  .doc-topbar .mark-icon { height: 32px; width: auto; }

  .page-h1 { text-align: center; font-family: 'Cinzel', serif; font-weight: 600; font-size: 24px; color: var(--earth); margin: 18px 0 6px; letter-spacing: 0.02em; }
  .h1-underline { width: 46px; height: 2px; background: var(--gold); margin: 0 auto 20px; }

  .doc-footer { position: absolute; left: 0; right: 0; bottom: 0; background: var(--tan); padding: 9px 16mm; display: flex; align-items: center; justify-content: center; gap: 8px; }
  .doc-footer .ft-text { font-size: 8.3px; color: var(--earth); letter-spacing: 0.03em; }
  .doc-footer .ft-text b { letter-spacing: 0.1em; }

  .cover-top { text-align: center; padding-top: 16mm; position: relative; z-index: 2; }
  .cover-top img.mark-icon { height: 130px; width: auto; }

  .cover-title-block { padding: 30px 18mm 0; position: relative; z-index: 2; }
  .cover-title { font-family: 'Cinzel', serif; font-weight: 600; font-size: 34px; color: var(--earth); line-height: 1.15; letter-spacing: 0.02em; text-transform: uppercase; }
  .cover-subtitle { font-size: 10px; letter-spacing: 0.18em; color: var(--grey); font-weight: 500; text-transform: uppercase; line-height: 1.6; margin-top: 12px; }
  .cover-dash { width: 34px; height: 2px; background: var(--gold); margin-top: 12px; }
  .cover-audience-tag { position: absolute; top: 16mm; right: 16mm; z-index: 3; font-size: 8px; letter-spacing: 0.18em; color: var(--gold-deep); font-weight: 600; text-transform: uppercase; border: 1px solid var(--gold); border-radius: 3px; padding: 4px 9px; background: rgba(251, 247, 240, 0.85); }

  .cover-photo-wrap { width: 100%; margin-top: 26px; position: relative; z-index: 2; line-height: 0; flex: 1; }
  .cover-photo-wrap img { width: 100%; height: 100%; display: block; object-fit: cover; }

  .quote-meta { display: flex; align-items: center; gap: 18px; margin: 14px 16mm 0; padding: 16px 22px; background: var(--tan-light); border: 1px solid var(--line); border-radius: 6px; }
  .qm-item { flex: 1.25; }
  .qm-item.wide { flex: 1.6; }
  .qm-div { width: 1px; align-self: stretch; background: var(--line); }
  .qm-lbl { font-size: 7.5px; letter-spacing: 0.16em; color: var(--gold-deep); font-weight: 600; text-transform: uppercase; }
  .qm-val { font-size: 10.5px; color: var(--earth); font-weight: 500; margin-top: 4px; }
  .qm-name { font-family: 'Alex Brush', cursive; font-size: 21px; color: var(--earth); margin-top: 3px; line-height: 1; white-space: nowrap; }

  .itin { padding: 0 16mm; position: relative; }
  .itin-line { position: absolute; left: 16mm; top: 6px; bottom: 6px; width: 1.5px; background: var(--gold); opacity: 0.4; margin-left: 15px; }
  .itin-head-row { display: grid; grid-template-columns: 48px 130px 1fr 175px; gap: 14px; padding: 0 0 9px; border-bottom: 1.5px solid var(--earth); }
  .itin-head-row span { font-family: 'Cinzel', serif; font-size: 9.5px; letter-spacing: 0.12em; color: var(--earth); text-transform: uppercase; font-weight: 600; }
  .itin-row { display: grid; grid-template-columns: 48px 130px 1fr 175px; gap: 14px; padding: 21px 0; border-bottom: 1px solid var(--line); position: relative; align-items: center; }
  .itin-row:last-child { border-bottom: none; }
  .day-badge { width: 38px; height: 38px; border-radius: 50%; background: var(--gold); color: #fff; font-family: 'Cinzel', serif; font-weight: 700; font-size: 9.5px; display: flex; align-items: center; justify-content: center; position: relative; z-index: 2; }
  .dest { font-size: 12px; font-weight: 700; letter-spacing: 0.03em; color: var(--earth); text-transform: uppercase; line-height: 1.3; }
  .details { font-size: 10px; color: #5c4c3a; line-height: 1.5; }
  .overnight { display: flex; align-items: center; gap: 9px; }
  .overnight .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--gold); flex: none; }
  .overnight img.plogo { height: 26px; width: auto; flex: none; }
  .overnight .ov-text { line-height: 1.35; }
  .overnight .ov-name { font-size: 10px; font-weight: 700; letter-spacing: 0.02em; color: var(--earth); text-transform: uppercase; }
  .overnight .ov-meal { font-size: 8.7px; color: var(--grey); }
  .overnight .ov-none { font-size: 9px; color: #a2937b; font-style: italic; }

  /* ============ FINANCIAL DETAIL PAGES (agent-only): flowing content, not
     fixed-height boxes, since a property-by-property breakdown's length
     depends on the itinerary and must never be silently clipped. Same visual
     language (colors, type, table treatment) as the pages above, just laid
     out for natural print pagination instead of one screen-sized box. ============ */
  .detail-wrap { background: var(--bg); page: detail; }
  .detail-section { page-break-inside: avoid; margin: 14px 0; }

  table.pricing { width: 100%; border-collapse: collapse; }
  table.pricing thead tr.band th { background: var(--band); color: #FBF7F0; font-family: 'Cinzel', serif; font-size: 12px; letter-spacing: 0.14em; padding: 13px 0; text-align: center; text-transform: uppercase; }
  table.pricing thead tr.cols th { background: var(--tan-light); font-size: 8.7px; letter-spacing: 0.1em; color: var(--earth); text-transform: uppercase; padding: 10px 12px; text-align: left; font-weight: 600; }
  table.pricing thead tr.cols th.r { text-align: right; }
  table.pricing tbody td { padding: 9px 12px; border-bottom: 1px solid var(--line); font-size: 10.5px; color: var(--earth); }
  table.pricing tbody td.r { text-align: right; }
  table.pricing tfoot td { background: var(--band); color: #fff; font-family: 'Cinzel', serif; font-weight: 700; font-size: 12px; letter-spacing: 0.06em; padding: 15px 12px; }
  table.pricing tfoot td.r { text-align: right; font-size: 16px; }

  .fees-label { font-size: 9px; letter-spacing: 0.14em; color: var(--gold-deep); font-weight: 600; text-transform: uppercase; margin: 14px 0 6px; }
  table.fees { width: 100%; border-collapse: collapse; margin-bottom: 4px; }
  table.fees td { border-bottom: 1px dashed var(--line); padding: 6px 12px; font-size: 9.7px; color: var(--earth); }
  table.fees td.r { text-align: right; }
  .discount-note { font-size: 8.7px; color: var(--grey); font-style: italic; margin: 6px 0 0; text-align: right; }
  .property-total-row { display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; background: var(--earth); color: #fff; font-family: 'Cinzel', serif; font-weight: 700; font-size: 11.5px; margin-top: 6px; border-radius: 4px; }

  .two-col { display: grid; grid-template-columns: 1.35fr 1fr; gap: 20px; margin-top: 14px; }
  .incl-excl h3 { font-family: 'Cinzel', serif; font-size: 12px; letter-spacing: 0.1em; color: var(--earth); margin: 0 0 9px; text-transform: uppercase; }
  .incl-excl ul { list-style: none; margin: 0 0 20px; padding: 0; }
  .incl-excl li { font-size: 9.7px; color: #5c4c3a; margin-bottom: 8px; padding-left: 17px; position: relative; line-height: 1.4; }
  .incl-excl li.yes::before { content: "\2713"; position: absolute; left: 0; color: var(--band); font-weight: 700; }
  .incl-excl li.no::before { content: "\2715"; position: absolute; left: 0; color: #8a4b2e; font-weight: 700; }

  .notes-card { border: 1px solid var(--gold); border-radius: 6px; padding: 14px 16px; text-align: center; height: fit-content; }
  .notes-card h3 { font-family: 'Cinzel', serif; font-size: 11px; letter-spacing: 0.14em; color: var(--gold-deep); margin: 0 0 8px; text-transform: uppercase; }
  .notes-card p { font-size: 9px; color: var(--grey); font-style: italic; margin: 0; line-height: 1.4; }
  .notes-card .sep { color: var(--gold); font-style: normal; margin: 6px 0; font-size: 8px; }

  .special-card { border: 1px solid var(--gold); border-radius: 6px; padding: 16px 20px; margin-top: 20px; }
  .special-card h3 { font-family: 'Cinzel', serif; font-size: 11px; letter-spacing: 0.14em; color: var(--gold-deep); margin: 0 0 10px; text-transform: uppercase; }
  .special-card ul { list-style: none; margin: 0; padding: 0; }
  .special-card li { font-size: 9.7px; color: #5c4c3a; margin-bottom: 6px; padding-left: 15px; position: relative; line-height: 1.4; }
  .special-card li::before { content: "\2022"; position: absolute; left: 0; color: var(--gold-deep); }
  .special-card li:last-child { margin-bottom: 0; }

  .closing { text-align: center; margin-top: 20px; }
  .closing .thanks-line { font-size: 9px; letter-spacing: 0.22em; color: var(--gold-deep); text-transform: uppercase; margin-bottom: 12px; }
  .closing .script { font-family: 'Alex Brush', cursive; font-size: 22px; color: var(--gold-deep); line-height: 1.3; }

  .plain-footer { margin-top: 16px; padding-top: 10px; border-top: 1px solid var(--line); text-align: center; font-size: 8.3px; color: var(--grey); }
</style>

<!-- ============ PAGE 1 — COVER (identical layout to the client copy) ============ -->
<div class="page cover">
  <div class="draft-tag">DRAFT — PENDING REVIEW — NOT FOR CLIENT USE UNTIL APPROVED</div>
  <div class="cover-audience-tag">Agent Copy — Full Breakdown</div>

  <div class="cover-top">
    <img class="mark-icon" src="{{masterLogo}}" alt="Soroi Collection" />
  </div>

  <div class="cover-title-block">
    <div class="cover-title">Safari<br>Quotation</div>
    <div class="cover-subtitle">Authentic Experiences.<br>Lasting Memories.</div>
    <div class="cover-dash"></div>
  </div>

  <div class="cover-photo-wrap">
    <img src="{{coverPhoto}}" alt="" />
  </div>
</div>

<!-- ============ PAGE 2 — ITINERARY (identical to the client copy) ============ -->
<div class="page">
  <div class="draft-tag">DRAFT — PENDING REVIEW — NOT FOR CLIENT USE UNTIL APPROVED</div>

  <div class="doc-topbar">
    <div class="side">Safari Quotation</div>
    <div class="mark">
      <div class="rule"></div>
      <img class="mark-icon" src="{{masterLogo}}" alt="" />
      <div class="rule"></div>
    </div>
    <div class="side">Itinerary</div>
  </div>

  <div class="quote-meta">
    <div class="qm-item wide">
      <div class="qm-lbl">Prepared By</div>
      <div class="qm-name">{{preparerName}}</div>
    </div>
    <div class="qm-div"></div>
    <div class="qm-item">
      <div class="qm-lbl">Date of Issue</div>
      <div class="qm-val">{{dateIssuedLabel}}</div>
    </div>
    <div class="qm-div"></div>
    <div class="qm-item">
      <div class="qm-lbl">Travel Dates</div>
      <div class="qm-val">{{travelDatesLabel}}</div>
    </div>
    <div class="qm-div"></div>
    <div class="qm-item">
      <div class="qm-lbl">Duration</div>
      <div class="qm-val">{{durationLabel}}</div>
    </div>
  </div>

  <div class="page-h1">Your Itinerary</div>
  <div class="h1-underline"></div>

  <div class="itin">
    <div class="itin-line"></div>
    <div class="itin-head-row">
      <span>Day</span><span>Destination</span><span>Details</span><span>Overnight</span>
    </div>

    {{#each itineraryDays}}
    <div class="itin-row">
      <div class="day-badge">{{this.dayLabel}}</div>
      <div class="dest">{{this.destination}}</div>
      <div class="details">{{this.details}}</div>
      <div class="overnight">
        {{#if this.overnightPropertyName}}
          {{#if this.overnightLogoDataUri}}
            <img class="plogo" src="{{this.overnightLogoDataUri}}" alt="" />
          {{else}}
            <span class="dot"></span>
          {{/if}}
          <div class="ov-text">
            <div class="ov-name">{{this.overnightPropertyName}}</div>
            {{#if this.mealPlanLabel}}<div class="ov-meal">{{this.mealPlanLabel}}</div>{{/if}}
          </div>
        {{else}}
          <span class="ov-none">&mdash;</span>
        {{/if}}
      </div>
    </div>
    {{/each}}
  </div>

  <div class="doc-footer">
    <div class="ft-text"><b>CONTACT US</b> &nbsp;|&nbsp; reservations@soroi.com &nbsp;&nbsp; +254 754 351 908 &nbsp;&nbsp; www.soroi.com</div>
  </div>
</div>

<!-- ============ PAGE 3+ — FINANCIAL DETAIL (agent-only, flows naturally) ============ -->
<div class="detail-wrap">
  <div class="page-h1" style="text-align:left;">Rate Breakdown</div>
  <div class="h1-underline" style="margin-left:0;"></div>

  {{#each propertySections}}
  <div class="detail-section">
    <table class="pricing">
      <thead>
        <tr class="band"><th colspan="5">{{this.title}} &mdash; {{this.tier}} ({{this.residency}})</th></tr>
        <tr class="cols"><th>Description</th><th>Pax</th><th class="r">Nights</th><th class="r">Rate / Person / Night</th><th class="r">Subtotal</th></tr>
      </thead>
      <tbody>
        {{#each this.lineItems}}
        <tr><td>{{this.description}}</td><td>{{this.pax}}</td><td class="r">{{this.nights}}</td><td class="r">{{this.ratePerPersonPerNight}}</td><td class="r">{{this.subtotal}}</td></tr>
        {{/each}}
      </tbody>
      <tfoot><tr><td colspan="4">Accommodation Subtotal</td><td class="r">{{this.accommodationSubtotal}}</td></tr></tfoot>
    </table>
    {{#if this.circuitDiscountLabel}}<div class="discount-note">{{this.circuitDiscountLabel}}</div>{{/if}}

    {{#if this.mandatoryFees.length}}
    <div class="fees-label">Mandatory Local Charges</div>
    <table class="fees">
      {{#each this.mandatoryFees}}
      <tr><td>{{this.description}}</td><td class="r">{{this.amount}}</td></tr>
      {{/each}}
      <tr><td><strong>Fees Subtotal</strong></td><td class="r"><strong>{{this.mandatoryFeesSubtotal}}</strong></td></tr>
    </table>
    {{/if}}

    <div class="property-total-row"><span>{{this.displayName}} Total</span><span>{{this.propertyTotal}}</span></div>
  </div>
  {{/each}}

  {{#if hasTransfers}}
  <div class="detail-section">
    <table class="pricing">
      <thead>
        <tr class="band"><th colspan="2">Transfers</th></tr>
        <tr class="cols"><th>Description</th><th class="r">Amount</th></tr>
      </thead>
      <tbody>
        {{#each transfers}}
        <tr><td>{{this.description}}</td><td class="r">{{this.amount}}</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{/if}}

  <div class="detail-section">
    <table class="pricing">
      <thead>
        <tr class="band"><th colspan="2">Quotation Summary &mdash; {{guestsSummary}}</th></tr>
        <tr class="cols"><th>Description</th><th class="r">Total (USD)</th></tr>
      </thead>
      <tbody>
        {{#each summaryRows}}
        <tr><td>{{this.description}}</td><td class="r">{{this.amount}}</td></tr>
        {{/each}}
      </tbody>
      <tfoot><tr><td>Grand Total</td><td class="r">{{grandTotal}}</td></tr></tfoot>
    </table>
  </div>

  <div class="two-col detail-section">
    <div class="incl-excl">
      <h3>Inclusions</h3>
      <ul>{{#each inclusions}}<li class="yes">{{this}}</li>{{/each}}</ul>
      <h3>Exclusions</h3>
      <ul>{{#each exclusions}}<li class="no">{{this}}</li>{{/each}}</ul>
    </div>
    <div class="notes-card">
      <h3>Important Notes</h3>
      {{#each notes}}
      <p>{{this}}</p>
      {{#unless @last}}<div class="sep">&#10022;</div>{{/unless}}
      {{/each}}
    </div>
  </div>

  {{#if specialRequests.length}}
  <div class="special-card detail-section">
    <h3>Special Requests &amp; Notes For This Trip</h3>
    <ul>
      {{#each specialRequests}}<li>{{this}}</li>{{/each}}
    </ul>
  </div>
  {{/if}}

  <div class="detail-section">
    <div class="closing">
      <div class="thanks-line">Thank You For Considering Soroi Collection</div>
      <div class="script">We look forward to welcoming you to<br>experience the magic of Africa.</div>
    </div>

    <div class="plain-footer">
      reservations@soroi.com &nbsp;&nbsp;|&nbsp;&nbsp; +254 754 351 908 &nbsp;&nbsp;|&nbsp;&nbsp; www.soroi.com &nbsp;&nbsp;|&nbsp;&nbsp; Quote Ref: {{quoteId}}
    </div>
  </div>
</div>
