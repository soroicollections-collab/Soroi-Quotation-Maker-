# Local dev: point at a local Postgres instance.
# Production (Vercel): Neon's pooled connection string (has "-pooler" in the hostname).
DATABASE_URL="postgresql://user@localhost:5432/soroi_quotation_dev?schema=public"

# Generate with: npx auth secret   (or: openssl rand -base64 32)
# Use a fresh value in production - do not reuse the local dev secret.
AUTH_SECRET="replace-with-a-real-secret"

# Anthropic Console API key - personal pay-as-you-go key for the demo phase,
# swappable for a company key later with no code change.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL_EXTRACTION="claude-opus-5"
ANTHROPIC_MODEL_CHAT="claude-sonnet-5"

# No file storage config needed - PDFs are rendered on demand and streamed
# straight to the browser, never written to disk or a bucket. See DEPLOY.md.
