# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Unrooted (not "/node_modules") because render-service/ is a separate npm package
# inside this repo (see its own README) with its own node_modules to also catch.
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# leftover from the pre-"stream-only" architecture - rate uploads and generated
# PDFs are no longer written to disk anywhere; nothing should land here again,
# but ignore it rather than delete a file that predates that refactor.
/storage

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
